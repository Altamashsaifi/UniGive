# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=unigive_db
PGUSER=postgres
PGPASSWORD=your_postgres_password
# Alternatively, connection string:
# DATABASE_URL=postgres://postgres:password@localhost:5432/unigive_db

# JWT Secret
JWT_SECRET=unigive_super_secure_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Cloudinary (Afifa - Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=campus.unigive@college.ac.in
SMTP_PASS=your_app_password
